rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(
            /databases/(default)/documents/admins/$(request.auth.uid)
           );
    }


    // Users can upload ONLY into their own folder
    match /customizationRequests/{userId}/{fileName} {
      allow write: if signedIn() && request.auth.uid == userId;
      allow read: if true;
    }

    // Return request images — user can write to their own folder, public read
    match /returns/{userId}/{fileName} {
      allow write: if signedIn() && request.auth.uid == userId;
      allow read: if true;
    }

    // Product images — public read, admin-only write
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
